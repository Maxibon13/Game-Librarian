{
  "name": "gamelibrarian",
  "version": "1.0.0-pre",
  "private": true,
  "description": "Cross-platform game library that unifies multiple launchers (Steam, Epic, etc.)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "electron tests/ui-smoke.cjs",
    "dev": "concurrently -k -s first \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "start": "electron .",
    "build": "vite build",
    "build:ui": "vite build",
    "dist:dir": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis",
    "dist": "electron-builder -w",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build_release.ps1",
    "postinstall": "node tools/postinstall.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vdf-extra": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gamelibrarian.app",
    "productName": "Game Librarian",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "src/main/**",
      "src/renderer/**",
      "assets/**",
      "package.json",
      "Version.Json"
    ],
    "extraResources": [
      { "from": "tools", "to": "tools", "filter": ["**/*", "!postinstall.mjs"] },
      { "from": "runtime/python", "to": "python", "filter": ["**/*"] },
      { "from": "installer", "to": "installer", "filter": ["Installer.exe", "Uninstaller.exe"] },
      { "from": "assets/icons", "to": "assets/icons", "filter": ["Icon.png", "Icon.ico"] },
      { "from": "Version.Json", "to": "Version.Json" }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
